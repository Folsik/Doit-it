# Local development only. Do not reuse these values in production.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://doit:doit_dev_password@localhost:5432/doit?sslmode=disable
JWT_ISSUER=doit-api
ACCESS_TOKEN_TTL=15m

